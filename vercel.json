{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/aumara",
      "destination": "https://www.aumara.me/",
      "permanent": true
    },
    {
      "source": "/aumara/",
      "destination": "https://www.aumara.me/",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/elcid-site/index.html"
    },
    {
      "src": "^/(styles\\.css|site\\.js|official-logo\\.svg|legal\\.html|privacy\\.html|cookies\\.html|robots\\.txt|sitemap\\.xml|llms\\.txt)$",
      "dest": "/elcid-site/$1"
    },
    {
      "src": "^/\\.well-known/(.*)$",
      "dest": "/elcid-site/.well-known/$1"
    },
    {
      "src": "^/staff/?$",
      "dest": "/staff/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Signal",
          "value": "ai-train=no, search=yes, ai-input=yes"
        },
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/agent-skills/index.json>; rel=\"describedby\"; type=\"application/json\""
        }
      ]
    }
  ]
}
