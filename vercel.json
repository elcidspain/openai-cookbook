{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/aumara",
      "destination": "https://www.aumara.me/",
      "permanent": true
    },
    {
      "source": "/aumara/",
      "destination": "https://www.aumara.me/",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Content-Signal": "ai-train=no, search=yes, ai-input=yes",
        "Vary": "Accept",
        "Link": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/agent-skills/index.json>; rel=\"describedby\"; type=\"application/json\", </.well-known/mcp/server-card.json>; rel=\"describedby\"; type=\"application/json\""
      },
      "dest": "/elcid-site/index.md"
    },
    {
      "src": "^/$",
      "headers": {
        "Content-Signal": "ai-train=no, search=yes, ai-input=yes",
        "Vary": "Accept",
        "Link": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/agent-skills/index.json>; rel=\"describedby\"; type=\"application/json\", </.well-known/mcp/server-card.json>; rel=\"describedby\"; type=\"application/json\""
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/elcid-site/index.html"
    },
    {
      "src": "^/mcp$",
      "dest": "/api/elcid-mcp"
    },
    {
      "src": "^/(styles\\.css|site\\.js|official-logo\\.svg|legal\\.html|privacy\\.html|cookies\\.html|robots\\.txt|sitemap\\.xml|llms\\.txt)$",
      "dest": "/elcid-site/$1"
    },
    {
      "src": "^/\\.well-known/(.*)$",
      "dest": "/elcid-site/.well-known/$1"
    },
    {
      "src": "^/staff/?$",
      "dest": "/staff/index.html"
    },
    {
      "src": "^/.*$",
      "status": 404
    }
  ]
}
