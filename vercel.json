{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "exit 0",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/aumara",
      "destination": "https://www.aumara.me/",
      "permanent": true
    },
    {
      "source": "/aumara/",
      "destination": "https://www.aumara.me/",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/elcid-site/index.html"
    },
    {
      "src": "^/staff/?$",
      "dest": "/staff/index.html"
    }
  ]
}
