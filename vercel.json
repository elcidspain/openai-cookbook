{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "exit 0",
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/$",
      "dest": "/aumara-site/index.html"
    },
    {
      "src": "^/aumara/?$",
      "dest": "/aumara-site/index.html"
    },
    {
      "src": "^/staff/?$",
      "dest": "/staff/index.html"
    }
  ]
}
